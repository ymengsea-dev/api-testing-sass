# Generated by Cargo
# Contains all compiled files, binaries, and dependencies
/target/

# Remove Cargo.lock from .gitignore if you are creating an executable binary.
# Keep Cargo.lock in .gitignore only if you are building a library.
Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these to store debugging information
*.pdb

# Internal Compiler Error reports (rustc dumps stack traces here)
rustc-ice-*.txt

# Mutation testing data generated by cargo-mutants
**/mutants.out/

# JetBrains IDE (RustRover/IntelliJ) project files
.idea/

# VS Code directory (optional, uncomment if you want to ignore workspace configs)
#.vscode/
